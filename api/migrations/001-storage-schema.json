{
  "version": 1,
  "provider": "azure-cosmos-nosql",
  "description": "Versioned Cosmos DB schema for the Blitzboard Studio API. No records are inserted.",
  "database": "blitzboard-studio",
  "container": {
    "id": "playboard",
    "partitionKeyPath": "/partitionKey",
    "entities": {
      "playbooks": ["id", "name", "createdAt", "updatedAt"],
      "plays": ["id", "parentId", "name", "template", "createdAt", "updatedAt"],
      "slides": ["id", "parentId", "createdAt", "updatedAt"],
      "exports": ["id", "status", "createdAt"],
      "gamePlans": ["id", "name", "createdAt", "updatedAt"],
      "scoutPlays": ["id", "parentId", "name", "template", "createdAt", "updatedAt"]
    }
  }
}